# Postgres connection string (Prisma Postgres, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password you type in at /admin/login
ADMIN_PASSWORD="choose-a-strong-password"

# Long random string used to sign the admin login cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET="replace-with-a-long-random-string"

# WhatsApp number the shop receives order confirmations on (digits only, country code, no +)
SHOP_WHATSAPP_NUMBER="233599295013"
